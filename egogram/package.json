{
  "name": "app",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "vite build && gh-pages -d dist --add",
    "deploy:clean": "node -e \"console.error('deploy:clean 막음 — 브랜치 전체를 갈아 일반판 /org/까지 지운다 (SPEC-org-edition §7)'); process.exit(1)\"",
    "dev:org": "vite --mode org",
    "build:org": "vite build --mode org",
    "deploy:org": "vite build --mode org && rm -f dist-org/CNAME && gh-pages -d dist-org --dest org --add",
    "check:terms": "node scripts/check-ego-terms.mjs",
    "check:fetch": "node scripts/check-fetch-all.mjs",
    "check:admin": "node scripts/check-admin-data.mjs",
    "check:admin-ui": "node scripts/check-admin-ui.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.5.0",
    "js-yaml": "^4.1.1",
    "vite": "^8.0.10"
  }
}
